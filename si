import org.exolab.castor.builder.SourceGenerator;

import java.io.*;
import java.nio.file.*;
import java.util.regex.*;

public class CastorWsdlCodeGenerator {

    public static void main(String[] args) {
        File wsdlDir = new File("src/main/resources/wsdl"); // Folder with WSDLs
        File[] wsdlFiles = wsdlDir.listFiles((dir, name) -> name.endsWith(".wsdl"));

        if (wsdlFiles == null || wsdlFiles.length == 0) {
            System.out.println("❌ No WSDL files found in: " + wsdlDir.getAbsolutePath());
            return;
        }

        for (File wsdl : wsdlFiles) {
            try {
                System.out.println("\n📄 Processing: " + wsdl.getName());
                String wsdlContent = Files.readString(wsdl.toPath());

                // Extract <xs:schema>...</xs:schema>
                Matcher matcher = Pattern.compile(
                        "<xs:schema[\\s\\S]+?</xs:schema>",
                        Pattern.CASE_INSENSITIVE | Pattern.MULTILINE
                ).matcher(wsdlContent);

                if (!matcher.find()) {
                    System.out.println("❌ No schema found in " + wsdl.getName());
                    continue;
                }

                String xsdContent = matcher.group(0);
                String moduleName = wsdl.getName().replace(".wsdl", "").toLowerCase();

                // Save extracted schema to temporary .xsd
                File tempXsdFile = new File("target/generated-xsds/" + moduleName + ".xsd");
                tempXsdFile.getParentFile().mkdirs();
                Files.writeString(tempXsdFile.toPath(), xsdContent);
                System.out.println("✅ Extracted schema → " + tempXsdFile.getPath());

                // Generate Java classes using Castor
                String outputPackage = "com.yourcompany.si." + moduleName + ".dependencies";
                System.out.println("⚙️ Generating Castor classes → " + outputPackage);

                SourceGenerator.main(new String[]{
                        "-i", tempXsdFile.getAbsolutePath(),
                        "-package", outputPackage,
                        "-o", "src/main/java"
                });

                System.out.println("✅ Code generated for module: " + moduleName);

            } catch (Exception e) {
                System.out.println("❌ Failed for " + wsdl.getName());
                e.printStackTrace();
            }
        }
    }
}
